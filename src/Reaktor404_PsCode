// 1. KLASSE: Raumschiff
// Verwaltet die Schiffsattribute, Wertegrenzen (0-100) und Abzugslogik
// ============================================================================

KLASSE Raumschiff:
    // Schiffsattribute (0 bis 100)
    PRIVAT reaktor: INTEGER
    PRIVAT huelle: INTEGER
    PRIVAT kuehlung: INTEGER

    KONSTRUKTOR Raumschiff():
        // Startwerte wie in meinem Konstruktor gesetzt
        reaktor = 100
        huelle = 100
        kuehlung = 100

    // Meine universelle Hilfsmethode zur Wertebegrenzung zwischen 0 und 100
    PRIVAT METHODE begrenzen(wert: INTEGER) -> INTEGER:
        IF wert < 0 THEN
            RETURN 0
        ELSE IF wert > 100 THEN
            RETURN 100
        ELSE
            RETURN wert
        END IF

    // Sekundlicher Zerfall der Schiffssysteme
    METHODE tick():
        kuehlung = begrenzen(kuehlung - 1)
        huelle = begrenzen(huelle - 1)

        // Wenn Kühlung leer ist, verliert der Reaktor viermal so schnell Stabilität (-4)
        IF kuehlung <= 0 THEN
            reaktor = begrenzen(reaktor - 4)
        ELSE
            reaktor = begrenzen(reaktor - 1)
        END IF

    // Manuelle Reparaturen & Nachfüllen
    METHODE reaktorReparieren():
        // Benötigt mindestens 10 Kühlung als Ressource
        IF kuehlung >= 10 THEN
            kuehlung = begrenzen(kuehlung - 10)
            reaktor = begrenzen(reaktor + 15)
        END IF

    METHODE huelleReparieren():
        huelle = begrenzen(huelle + 20)

    METHODE kuehlungAuffuellen():
        kuehlung = begrenzen(kuehlung + 25)

    // Schadensmethoden bei Asteroid & verpasstem Notfall
    METHODE asteroidTreffer():
        huelle = begrenzen(huelle - 20)
        reaktor = begrenzen(reaktor - 15)

    METHODE notfallSchaden():
        huelle = begrenzen(huelle - 15)
        reaktor = begrenzen(reaktor - 10)

    // Abbruchprüfung: Reaktor oder Hülle auf 0
    METHODE istZerstoert() -> BOOLEAN:
        RETURN (reaktor <= 0 OR huelle <= 0)

    // Getter
    METHODE getReaktor() -> INTEGER: RETURN reaktor
    METHODE getHuelle() -> INTEGER: RETURN huelle
    METHODE getKuehlung() -> INTEGER: RETURN kuehlung
END KLASSE
