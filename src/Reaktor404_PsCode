// 2. KLASSE: EreignisManager
// Verwaltet die Zufallstimer für Asteroiden und den 6-Sekunden-Notfalltakt
// ============================================================================

KLASSE EreignisManager:
    PRIVAT hatNotfall: BOOLEAN
    PRIVAT notfallSekunden: INTEGER
    PRIVAT naechsterAsteroid: INTEGER
    PRIVAT zufall: Random

    KONSTRUKTOR EreignisManager():
        zufall = NEW Random()
        hatNotfall = FALSE
        notfallSekunden = 0
        naechsterAsteroidBerechnen()

    // Berechnet zufälligen Abstand: 8 + Zufall(0..8) -> 8 bis 16 Sekunden
    PRIVAT METHODE naechsterAsteroidBerechnen():
        naechsterAsteroid = 8 + zufall.nextInt(9)

    // Wird pro Spielsekunde aufgerufen: Zählt den Einschlag-Timer runter
    METHODE tick() -> BOOLEAN:
        IF NOT hatNotfall THEN
            naechsterAsteroid = naechsterAsteroid - 1
            IF naechsterAsteroid <= 0 THEN
                hatNotfall = TRUE
                notfallSekunden = 6
                naechsterAsteroidBerechnen()
                RETURN TRUE // Löst Einschlag aus
            END IF
        END IF
        RETURN FALSE

    // Zählt während eines aktiven Notfalls die verbleibende Reaktionszeit runter
    METHODE notfallTick() -> BOOLEAN:
        IF hatNotfall THEN
            notfallSekunden = notfallSekunden - 1
            IF notfallSekunden <= 0 THEN
                hatNotfall = FALSE
                RETURN TRUE // Frist verpasst -> Zusatzschaden fällig
            END IF
        END IF
        RETURN FALSE

    // Vom Notfall-Button aufgerufen
    METHODE notfallBeheben():
        hatNotfall = FALSE
        notfallSekunden = 0

    // Getter
    METHODE hatNotfall() -> BOOLEAN: RETURN hatNotfall
    METHODE getNotfallSekunden() -> INTEGER: RETURN notfallSekunden
END KLASSE
